{
  "meta": {
    "name": "Default Professional",
    "version": "1.0.0",
    "title": "Document",
    "lang": "en"
  },
  "page": {
    "type": "a4",
    "orientation": "portrait",
    "margins": {
      "top": "10mm",
      "right": "10mm",
      "bottom": "10mm",
      "left": "10mm"
    }
  },
  "styles": {
    "p": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-size": "11pt",
      "line-height": 1.6,
      "color": "#2b2b2b"
    },
    "h1": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 700,
      "font-size": "28pt",
      "color": "#1a1a1a"
    },
    "h2": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 700,
      "font-size": "22pt",
      "color": "#1a1a1a"
    },
    "h3": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 700,
      "font-size": "18pt",
      "color": "#1a1a1a"
    },
    "h4": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 600,
      "font-size": "16pt",
      "color": "#1f2937"
    },
    "h5": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 600,
      "font-size": "13pt",
      "color": "#374151"
    },
    "h6": {
      "font-family": "Inter, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "font-weight": 600,
      "font-size": "11pt",
      "color": "#4b5563"
    },
    "code": {
      "font-family": "JetBrains Mono, SFMono-Regular, Menlo, Consolas, monospace",
      "font-size": "10pt",
      "color": "#0f172a",
      "background-color": "#f6f8fa"
    },
    "pre": {
      "font-family": "JetBrains Mono, SFMono-Regular, Menlo, Consolas, monospace",
      "font-size": "10pt",
      "color": "#0f172a",
      "background-color": "#f6f8fa"
    },
    "blockquote": {
      "color": "#444444",
      "background-color": "#f9fafb",
      "font-style": "italic"
    },
    "table": {
      "background-color": "#ffffff",
      "color": "#2b2b2b"
    },
    "th": {
      "font-weight": 700,
      "color": "#1a1a1a",
      "background-color": "#f3f4f6"
    },
    "td": {
      "color": "#2b2b2b"
    },
    "hr": {
      "fill": "#e5e7eb",
      "color": "#e5e7eb"
    },
    "a": {
      "color": "#2563eb"
    }
  },
  "formats": {
    "html": {
      "page": {
        "type": "a4",
        "margins": {
          "top": "10mm",
          "right": "10mm",
          "bottom": "10mm",
          "left": "10mm"
        }
      },
      "styles": {
        "h1": { "font-size": "26pt" },
        "h2": { "font-size": "20pt" },
        "h3": { "font-size": "16pt" },
        "a": { "color": "#2563eb" }
      }
    },
    "docx": {
      "page": {
        "type": "a4",
        "margins": {
          "top": "10mm",
          "right": "10mm",
          "bottom": "10mm",
          "left": "10mm"
        }
      },
      "styles": {
        "code": { "font-family": "Consolas, monospace", "font-size": "10pt" }
      }
    },
    "pptx": {
      "styles": {
        "h1": { "font-size": "32pt" },
        "h2": { "font-size": "24pt" },
        "p": { "font-size": "18pt" }
      }
    }
  }
}
